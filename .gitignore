node_modules/
# every ministry source file — 128 MiB measured, all re-downloadable. SOURCES.md is the inventory
# (with URLs and as-of dates) so no session has to list this directory.
data/
# generated: rebuild with `npm run index` (and `npm run app` to bake into the page)
out/
# the same files on the opt-in census deprivation basis: `npm run index:nonemp`
out_nonemp/
test/node_modules/
# playwright screenshots from test/batch.mjs. It writes `b_<name>_map.png` to the CURRENT directory,
# so they land in test/ when run as documented and in the repo root when run from there. Ignore both.
test/*.png
b_*_map.png
.DS_Store
# school contact addresses, generated by `npm run app` into app/contacts.js — personal data,
# 77% consumer inboxes belonging to named head teachers. The app runs without it.
app/contacts.js
